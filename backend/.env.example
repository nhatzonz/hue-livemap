# Copy thành backend/.env rồi chỉnh nếu cần.
APP_ENV=development

# PostgreSQL 17 + PostGIS (Homebrew) chạy ở cổng 5433, user = tài khoản macOS, không mật khẩu
DATABASE_URL=postgresql+psycopg://localhost:5433/hue_livemap
# tests/conftest.py đọc biến môi trường TEST_DATABASE_URL (không đọc từ file .env này); mặc định như dưới
# TEST_DATABASE_URL=postgresql+psycopg://localhost:5433/hue_livemap_test

# Origin được phép gọi API từ trình duyệt (web dashboard), cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Bật /docs (OpenAPI UI). Tắt ở production.
ENABLE_DOCS=true

# Có trả dữ liệu demo (is_demo = true) hay không. LUÔN false ở production.
INCLUDE_DEMO_DATA=true

# Hiện cả đoạn chưa khảo sát thực địa (nháp từ OSM). LUÔN false ở pilot/production.
SHOW_UNVERIFIED_SEGMENTS=true

# Ký JWT. BẮT BUỘC đặt chuỗi ngẫu nhiên ≥ 32 ký tự ở staging/production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Thư mục lưu ảnh phản ánh (tương đối với backend/). Production: chuyển sang S3-compatible.
MEDIA_DIR=var/media

# Job nền tính suy giảm trạng thái mỗi phút. Chỉ bật ở MỘT process API.
ENABLE_JOBS=true
